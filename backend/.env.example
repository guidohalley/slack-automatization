# Postgres connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/slack_automatization"

# Slack app credentials (Bolt). The bot token belongs to OUR Slack app, the
# one that posts client reports and mentions @Cursor. Follow-ups from the
# widget ("ask-status") reuse this same token/app so Cursor accepts them as
# coming from the agent's owner.
SLACK_BOT_TOKEN="xoxb-..."
SLACK_SIGNING_SECRET="..."

# Slack USER token (starts with "xoxp-...") of a real human account in the
# workspace. Cursor's Slack app silently ignores @mentions posted by other
# bots (confirmed: zero reaction, not even an error) - only a message that
# looks like it came from an actual person triggers it. This token is used
# only for the message that mentions @Cursor; everything else (the initial
# report, screenshot upload) still uses the bot token above. Get it from
# api.slack.com/apps -> your app -> OAuth & Permissions -> add "chat:write"
# under User Token Scopes -> reinstall the app -> copy "User OAuth Token".
SLACK_USER_TOKEN="xoxp-..."

# Slack bot_id (starts with "B...") of Cursor's Slack app. There is no way to
# know this value up front: post a task once, inspect the first incoming
# `message` event from Cursor's bot in the /api/slack/events logs, copy its
# `bot_id`, and set it here. Events from any other bot_id are ignored.
CURSOR_BOT_ID="B0XXXXXXX"

# Slack user id (starts with "U...") of Cursor's app user. Used to build a
# real Slack mention (<@U...>) so the message actually notifies/triggers the
# Cursor app instead of posting inert text. If unset, falls back to the
# literal text "@Cursor", which will NOT trigger the agent.
CURSOR_SLACK_USER_ID="U0XXXXXXX"

PORT=3000

# Comma-separated list of origins allowed to call this API from the browser
# (the hosts embedding the widget).
CORS_ALLOWED_ORIGINS="https://cliente-uno.com,https://cliente-dos.com"
